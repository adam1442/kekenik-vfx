# Normalise line endings in the repository; checkouts use the platform default.
* text=auto eol=lf

*.wgsl text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.woff binary
*.woff2 binary

# Generated files: collapse in diffs and exclude from language statistics
package-lock.json -diff linguist-generated
THIRD_PARTY_NOTICES.md linguist-generated
docs/NODE_REFERENCE.md linguist-generated
samples/index.json linguist-generated
dist/** linguist-generated
